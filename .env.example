# LLM providers: Gemini is primary, Claude is the fallback. One key is enough.
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides
# GEMINI_MAIN_MODEL=gemini-3.1-flash-lite
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# CLAUDE_MAIN_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5

# Vector DB (falls back to embedded file mode in ./qdrant_data if unreachable)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Indexing
# INDEX_DIR=index
# INDEX_SKIP_DIRS=tests,scripts

# Run generated unit tests in a subprocess (executes model-written code on this machine)
# ENABLE_TEST_SANDBOX=1

# LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT="codebase-copilot"
